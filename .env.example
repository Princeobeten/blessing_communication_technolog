# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/crms

# Secret used to sign session JWTs - use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Optional: payment gateway key (billing module runs without it)
# PAYSTACK_SECRET_KEY=

# Resend email delivery (https://resend.com)
# When set, emails are sent via Resend instead of being logged to the console.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The "From" address - must be a verified domain/address in your Resend account.
RESEND_FROM_EMAIL=CRMS <noreply@yourdomain.com>
